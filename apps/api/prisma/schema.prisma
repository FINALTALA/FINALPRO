generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts for Migrate/CLI
// purposes; the runtime PrismaClient gets its connection via a driver
// adapter (@prisma/adapter-pg) constructed from DATABASE_URL in code,
// not from a `url` field here - see https://pris.ly/d/prisma7-client-config
datasource db {
  provider = "postgresql"
}

/// Part 1, Section C's platform-side roles (Platform Admin,
/// Matching/Verification Reviewer, ...). The SRS defines these roles'
/// permission boundaries but never specifies a data-model mechanism for
/// them (Part 3 has no platform-role entity at all) - this is Sprint 3's
/// minimal, deliberately narrow addition: just enough to gate
/// FR-VEND-003's reviewer-decision endpoint, not the full staff-role
/// system (content moderator/support/finance/marketing are out of
/// scope). There is no self-service way to acquire this role - it is
/// assigned out-of-band (seed script / direct DB access), the same way
/// a real deployment would restrict it to vetted platform staff.
enum PlatformRole {
  VERIFICATION_REVIEWER
  PLATFORM_ADMIN
}

/// Part 3, G.3 identity domain. phone is the primary credential
/// (FR-AUTH-002); email is optional (Q12). phoneVerifiedAt is set once,
/// at registration, after a successful OTP verify - never cleared by a
/// later password reset or login (those re-prove the password, not
/// phone ownership).
model User {
  id              String        @id @default(uuid())
  phone           String        @unique
  passwordHash    String
  email           String?
  languagePref    String        @default("ar")
  phoneVerifiedAt DateTime?
  /// Bumped atomically alongside passwordHash on every password reset
  /// (Sprint 2 review fix). SessionData carries the version a session
  /// was issued under; SessionAuthGuard rejects a stale one even if the
  /// matching Redis keys were never actually deleted (e.g. Redis was
  /// down at reset time) - Postgres, not Redis availability, is the
  /// actual security boundary for "did a password reset invalidate
  /// this session."
  sessionVersion  Int           @default(0)
  /// Sprint 3 addition - see PlatformRole. Null (the default) for every
  /// regular customer/vendor account.
  platformRole    PlatformRole?
  createdAt       DateTime      @default(now())

  customerProfile  CustomerProfile?
  vendorUsers      VendorUser[]
  auditLogs        AuditLog[]
  reviewedBranches StoreBranch[]    @relation("BranchReviewer")
  sentStaffInvites StaffInvite[]    @relation("StaffInviter")
  stockMovements   StockMovement[]
  decidedNameChangeRequests CanonicalNameChangeRequest[]

  @@map("users")
}

/// Part 3, G.3: one-to-one with User. Split out (rather than folding
/// displayName etc. into User) because Part 3 models it as its own
/// entity - VendorUser and future staff-role entities reference User
/// directly, not CustomerProfile, so a vendor-only account never needs
/// one.
model CustomerProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
  displayName String?

  addresses Address[]

  @@map("customer_profiles")
}

/// Part 3, G.3 (FR-AUTH-008): map pin + landmark + up to two phone
/// numbers, supporting BR-020's two-phone-number delivery-confirmation
/// requirement. Sprint 2 (BL-AUTH-004) ships only creation - the
/// saved-addresses management screen (list/edit/delete) is BL-AUTH-004b,
/// a Should/stretch item deferred past the FYP Must scope.
model Address {
  id           String          @id @default(uuid())
  customerId   String
  customer     CustomerProfile @relation(fields: [customerId], references: [id])
  label        String?
  lat          Float
  lng          Float
  landmarkNote String?
  phoneNumber1 String
  phoneNumber2 String?
  createdAt    DateTime        @default(now())

  @@index([customerId])
  @@map("addresses")
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
  PHONE_CHANGE
  /// Sprint 4 (RB-ROLE-002, PDR-008): proves phone ownership before a
  /// StaffInvite is accepted - the same `POST /auth/otp/request` /
  /// `POST /auth/otp/verify` pair every other purpose uses, gated the
  /// same way PASSWORD_RESET is (only issued when something real is
  /// waiting on the other end - see AuthController.requestOtp).
  STAFF_INVITE
}

/// Backs `POST /auth/otp/request` / `POST /auth/otp/verify` (Part 4,
/// H.3; FR-AUTH-003/005/006). Only codeHash is stored, never the
/// plaintext code - the code itself is only ever surfaced through the
/// OPEN-004 logged/fallback channel (SmsService), matching Part 1 D.4's
/// documented FYP fallback for the still-unselected SMS/OTP provider.
/// attemptCount backs the 429 TOO_MANY_ATTEMPTS response Part 4
/// specifies; consumedAt enforces "consumption happens exactly once."
///
/// consumedByKey (Sprint 2 review fix): the client's Idempotency-Key
/// header value at the moment of consumption, set atomically alongside
/// consumedAt in the same consume() write. Lets a *retry with that
/// exact same key* prove it - and only it - legitimately consumed this
/// row, for recovering from a since-failed completion write elsewhere
/// (IdempotencyInterceptor's own bookkeeping, or PhoneVerificationService's
/// Redis-side recovery index - see otp.service.ts's findConsumedRecord()).
/// The exact-match requirement is load-bearing: without it, a
/// *different*, genuinely concurrent request under a different
/// Idempotency-Key that happened to present the same correct code (and
/// *lost* the atomic consume() race) could recover whatever the winner
/// received instead of correctly failing - defeating single-use under
/// exactly the concurrency scenario this whole mechanism exists to
/// protect.
///
/// Deliberately NOT storing the actual phone-verification bearer token
/// here: unlike this table (a normal, permanently-retained Postgres
/// table - backed up, WAL-logged, replicated), that token only ever
/// needs to survive as long as its own 15-minute Redis TTL already
/// bounds it to. See PhoneVerificationService's recovery-index methods.
model OtpCode {
  id            String     @id @default(uuid())
  phone         String
  purpose       OtpPurpose
  codeHash      String
  expiresAt     DateTime
  consumedAt    DateTime?
  consumedByKey String?
  attemptCount  Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

/// Part 2's vendor status lifecycle (E.2). Sprint 2 (BL-VEND-001) only
/// ever creates a Vendor at APPLIED - the UnderReview/Approved/Active
/// transitions belong to FR-VEND-003/004 (Sprint 3+ review workflow).
enum VendorStatus {
  APPLIED
  UNDER_REVIEW
  REJECTED
  APPROVED
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// Sprint 4 (RB-ROLE-001, PDR-008/009): BRANCH_EMPLOYEE replaces the old
/// Sprint 2 "owner-only, no sub-roles" fallback (BL-VEND-005b) - PDR-008
/// explicitly requires owner + branch-employee, not the full
/// admin/catalog/order-processing sub-role set FR-VEND-007/BL-VEND-005
/// describes (that remains out of scope). OWNER controls the whole
/// vendor - configuration, catalog, prices, staff, every branch's
/// orders/stock, subscription, analytics. BRANCH_EMPLOYEE is scoped to
/// exactly one branch's orders/stock only, per VendorUser.branchId -
/// see that field's comment for the invariant this enum's two values
/// impose on it.
enum VendorUserRole {
  OWNER
  BRANCH_EMPLOYEE
}

/// Part 3, G.3. Sprint 2 (BL-VEND-001) captures just enough to submit
/// an application - name, whether it's a physical location, and an
/// optional pin. The verification-evidence fields FR-VEND-002 requires
/// (a mandatory pin + storefront photo, checked before *approval* not
/// *submission*) are exercised starting BL-VEND-002 (Sprint 3);
/// verificationPhotoUrl/verificationStatus exist here now because
/// they're intrinsic to this entity per Part 3, not because Sprint 2
/// enforces them yet.
///
/// RESUBMISSION_REQUESTED (Sprint 3 addition) is distinct from REJECTED:
/// FR-VEND-003 names "approve, reject, or request resubmission" as three
/// separate reviewer outcomes, not two - a rejection is meant to be
/// terminal-ish, a resubmission request invites the vendor to try again
/// (BL-VEND-002's evidence-submission endpoint accepts a resubmission by
/// simply being callable again on the same branch, resetting status back
/// to PENDING).
enum BranchVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMISSION_REQUESTED
}

/// Sprint 3 remediation (PDR-033, approved-product-decisions-2026-09.md):
/// "a unified sandbox/trial subscription begins after verification,
/// lasts one month and has mock monthly renewal... on expiry,
/// listings/page are unavailable for new orders but the owner can see
/// the account and work existing pre-expiry orders; renewal restores
/// automatically." No Basic/Pro/tier logic - see `SubscriptionPlan`'s
/// removal note on `VendorSubscription`. Replaces the pre-remediation
/// NONE/ACTIVE/PAST_DUE/SUSPENDED/CANCELLED enum, which modeled a
/// grace-period billing lifecycle PDR-033 doesn't call for.
///
/// NONE: no trial ever activated (FR-VEND-004 gates offer creation on
/// reaching ACTIVE). ACTIVE: within its one-month window, or already
/// mock-renewed. EXPIRED: past `periodEnd` and not yet mock-renewed -
/// blocks *new* offer/listing creation (the gate this enum drives) but
/// never affects the vendor's own account access or already-placed
/// orders, which this enum doesn't model at all.
enum SubscriptionStatus {
  NONE
  ACTIVE
  EXPIRED
}

/// Sprint 5 (RB-STORE-001, PDR-010): "A verified store can be physical,
/// online-only, or hybrid." Defaults to PHYSICAL so every Sprint 1-4
/// vendor row (which only ever modeled physical branches via
/// StoreBranch.isPhysical) keeps its existing meaning unchanged - this
/// is a purely additive classification, not a migration of existing
/// branch data. ONLINE_ONLY/HYBRID stores get one hidden Warehouse (see
/// that model) and may add PickupPoints; nothing in the schema forces a
/// vendor to actually have one before switching storeType - RB-STORE-001
/// is the data model only, not an enforced setup wizard (see the
/// replan's own FYP-demo-scope note for RB-STORE-001/004).
enum StoreType {
  PHYSICAL
  ONLINE_ONLY
  HYBRID
}

model Vendor {
  id                 String             @id @default(uuid())
  legalName          String
  status             VendorStatus       @default(APPLIED)
  subscriptionStatus SubscriptionStatus @default(NONE)
  /// Sprint 5 (RB-STORE-001, PDR-010). See StoreType's own doc comment.
  storeType          StoreType          @default(PHYSICAL)
  /// Sprint 7 (RB-STOREF-001, PDR-011): the public storefront's stable
  /// URL segment - generated once at vendor creation (VendorsController.apply()),
  /// never editable afterward, deliberately separate from displayName
  /// below (which the owner can change freely without ever breaking a
  /// shared/bookmarked link). Globally unique across every vendor.
  slug String @unique
  /// Owner-editable public-facing name, distinct from legalName (the
  /// registration/legal identity captured at application time,
  /// unrelated to this sprint). Defaults to legalName at creation and
  /// diverges only once the owner explicitly changes it.
  displayName          String?
  logoUrl              String?
  bio                  String?
  coverImageUrl        String?
  coverColor           String?
  instagramUrl         String?
  facebookUrl          String?
  whatsappUrl          String?
  /// PDR-007: "Each store must publish at least one external contact
  /// route." Enforced only at the moment of publishing (StorefrontController.publish()
  /// checked in VendorsController), not continuously - an owner can
  /// still edit other storefront fields freely while unpublished with
  /// no contact set yet. Once true, the public storefront reports
  /// is_available (combined with `status === 'ACTIVE'`, see
  /// StorefrontController) - the name/identity stay visible either way
  /// ("المحل غير متاح حالياً" is a status shown alongside identity, never
  /// a 404).
  storefrontPublished  Boolean            @default(false)
  createdAt          DateTime           @default(now())

  vendorUsers     VendorUser[]
  storeBranches   StoreBranch[]
  subscriptions   VendorSubscription[]
  canonicalOffers VendorOffer[]
  offerVariants   OfferVariant[]
  staffInvites    StaffInvite[]
  warehouse       Warehouse?
  pickupPoints    PickupPoint[]
  deliveryZones   VendorDeliveryZone[]
  branchStocks    BranchStock[]
  stockMovements  StockMovement[]
  offerVariantMedia      OfferVariantMedia[]
  matchReviewCandidates  MatchReviewCandidate[]
  nameChangeRequests     CanonicalNameChangeRequest[]
  importIdentifierRecords ImportIdentifierRecord[]
  applicableCategories   VendorApplicableCategory[]
  storeSections          StoreSection[]

  @@map("vendors")
}

/// Sprint 5 (RB-STORE-001, PDR-010): "An online-only store has one
/// hidden warehouse execution location." One-to-one with Vendor
/// (vendorId is @unique below) - a store has at most one.
///
/// "Hidden" (review-round clarification) means hidden from customers,
/// from a BRANCH_EMPLOYEE, and from anyone who isn't a member of this
/// vendor at all - never from the vendor's own OWNER, who has to be
/// able to read back an operational setting they configured. There IS
/// a real read path: VendorsController's GET :vendorId/warehouse,
/// owner-only via VendorMembershipGuard + @RequireVendorRole('OWNER').
/// What must never happen is this model appearing in vendorSummaryDto()
/// or any other general-membership/public serializer - unlike
/// StoreBranch/PickupPoint (meant to eventually be customer-visible),
/// a warehouse is an internal fulfilment detail PDR-010 explicitly
/// calls "hidden" from everyone except the one role that manages it.
model Warehouse {
  id          String   @id @default(uuid())
  vendorId    String   @unique
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  lat         Float?
  lng         Float?
  addressNote String?
  createdAt   DateTime @default(now())

  @@map("warehouses")
}

/// Sprint 5 (RB-STORE-001, PDR-010): "may configure multiple public
/// pickup points; pickup points hold no stock." No relation to any
/// inventory/stock table exists on this model by design - branch-level
/// stock (RB-INV-002, not built this sprint) attaches only to
/// StoreBranch, never here. RB-STORE-003 (temporarily close / archive,
/// Should, not built this sprint) will eventually manage isActive's
/// lifecycle beyond a simple toggle; the public discovery/pickup
/// *workflow* itself (customer-facing listing, slot booking) is also
/// explicitly out of Sprint 5 scope - this is schema plus owner-facing
/// CRUD only.
model PickupPoint {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  name        String
  lat         Float?
  lng         Float?
  addressNote String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([vendorId])
  @@map("pickup_points")
}

/// Sprint 5 (RB-STORE-002, PDR-022): "Delivery fees are store-wide by
/// region: West Bank, Jerusalem, and Inside. A store may disable
/// zones." A deliberate static placeholder enum, not a geocoded
/// boundary lookup - OPEN-012 (the real boundary source) is still
/// unresolved; see the replan's §7 table. No fee-amount field: this
/// sprint's approved scope is explicitly the enable/disable
/// configuration only (checkout-time fee application is RB-ORD-003,
/// a later sprint).
enum DeliveryZoneRegion {
  WEST_BANK
  JERUSALEM
  INSIDE
}

/// Sprint 5 (RB-STORE-002). No row for a given (vendorId, region) pair
/// means that zone is enabled - a store starts with every zone on and
/// only gets a row once an owner explicitly disables (or re-enables
/// after disabling) one, the same lazy-default convention this
/// codebase already uses elsewhere (e.g. VendorSubscription's lazy
/// expiry check) rather than seeding three rows for every vendor at
/// creation time.
model VendorDeliveryZone {
  id        String             @id @default(uuid())
  vendorId  String
  vendor    Vendor             @relation(fields: [vendorId], references: [id])
  region    DeliveryZoneRegion
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())

  @@unique([vendorId, region])
  @@map("vendor_delivery_zones")
}

/// branchId (Sprint 4, RB-ROLE-001): null for OWNER (vendor-wide access),
/// required for BRANCH_EMPLOYEE (scoped to exactly this one branch) -
/// enforced by this table's own CHECK constraint (see the migration),
/// not just application code, so the invariant holds even against a
/// direct write. VendorMembershipGuard reads this alongside role on
/// every vendor-scoped route to decide access (see its own doc comment).
model VendorUser {
  id       String         @id @default(uuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id])
  vendorId String
  vendor   Vendor         @relation(fields: [vendorId], references: [id])
  role     VendorUserRole @default(OWNER)
  branchId String?
  /// Composite FK (vendorId, branchId) -> StoreBranch(vendorId, id), not
  /// a plain branchId -> StoreBranch.id FK (review-round finding): a
  /// single-column FK only proves the branch row *exists*, not that it
  /// belongs to *this* VendorUser's own vendorId - nothing stopped a
  /// direct write from linking an employee to a different vendor's
  /// branch. Sharing the vendorId column with the `vendor` relation
  /// above is deliberate and valid (a scalar column can participate in
  /// more than one FK); MATCH SIMPLE means this constraint is simply
  /// not checked when branchId is null (OWNER rows), matching this
  /// table's own role/branchId CHECK constraint exactly.
  branch   StoreBranch?   @relation(fields: [vendorId, branchId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, vendorId])
  @@index([branchId])
  /// Review-round finding (round 4): PDR-008 and SRS Part 3 G.0 - "a
  /// branch employee is assigned to exactly one branch **at a time**"
  /// means across every vendor, not per vendor. `@@unique([userId,
  /// vendorId])` above only ever stopped a duplicate row for the *same*
  /// vendor; it never stopped the same account becoming BRANCH_EMPLOYEE
  /// at a *different* vendor too. A partial unique index -
  /// `UNIQUE(userId) WHERE role = 'BRANCH_EMPLOYEE'`, hand-written in
  /// this model's migration, not representable in Prisma's schema DSL
  /// (same already-established pattern as this table's own
  /// role/branchId CHECK constraint) - closes that: an account may
  /// still OWNER any number of vendors (untouched, that role is
  /// excluded by the index's WHERE clause) and always remains a
  /// customer regardless, but may only ever hold one BRANCH_EMPLOYEE
  /// row at a time, full stop. Reassigning an employee to a different
  /// branch/vendor is RB-ROLE-003 (disable/transfer, Should, not built
  /// this sprint) - until then this is a one-way assignment.
  @@map("vendor_users")
}

model StoreBranch {
  id                   String                   @id @default(uuid())
  vendorId             String
  vendor               Vendor                   @relation(fields: [vendorId], references: [id])
  name                 String
  isPhysical           Boolean                  @default(true)
  lat                  Float?
  lng                  Float?
  verificationPhotoUrl String?
  verificationStatus   BranchVerificationStatus @default(PENDING)
  /// Set by the reviewer's decision (BL-VEND-003, FR-VEND-003) alongside
  /// verificationStatus. Nullable: never set for a branch still PENDING.
  reviewedBy           String?
  reviewer             User?                    @relation("BranchReviewer", fields: [reviewedBy], references: [id])
  reviewedAt           DateTime?
  /// The reviewer's reason on a REJECTED or RESUBMISSION_REQUESTED
  /// decision (FR-VEND-003) - what the vendor needs to know to fix and
  /// resubmit. Not set on APPROVED.
  reviewNote           String?
  createdAt            DateTime                 @default(now())

  vendorUsers    VendorUser[]
  staffInvites   StaffInvite[]
  branchStocks   BranchStock[]
  stockMovements StockMovement[]

  /// Backs the composite FKs on VendorUser/StaffInvite (vendorId,
  /// branchId) -> (vendorId, id) - a plain PK-only unique on `id`
  /// already exists, but a composite FK's referenced side must be
  /// itself unique on the exact column pair it's referenced by.
  @@unique([vendorId, id])
  @@index([vendorId])
  @@map("store_branches")
}

enum StaffInviteStatus {
  PENDING
  ACCEPTED
}

/// Sprint 4 (RB-ROLE-002, PDR-008): an owner-initiated invite for a
/// phone number to join one specific branch as BRANCH_EMPLOYEE - "same
/// pattern as signup" (OtpPurpose.STAFF_INVITE, the same
/// issue/check/consume/PhoneVerificationService-token flow SIGNUP
/// already uses) rather than a new mechanism. No EXPIRED status is
/// stored: expiry is computed lazily from expiresAt at accept time
/// (the same lazy-expiry pattern VendorSubscription uses), not written
/// by a background sweep this project has no worker for.
model StaffInvite {
  id          String            @id @default(uuid())
  vendorId    String
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
  branchId    String
  /// Same composite-FK reasoning as VendorUser.branch above - a plain
  /// branchId -> StoreBranch.id FK never verified the branch belonged
  /// to this same vendorId.
  branch      StoreBranch       @relation(fields: [vendorId, branchId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  phone       String
  invitedById String
  invitedBy   User              @relation("StaffInviter", fields: [invitedById], references: [id])
  status      StaffInviteStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([phone, status])
  @@index([vendorId])
  /// Review-round finding (round 4): at most one PENDING invite per
  /// *phone*, globally - not per (vendorId, phone). AuthController.
  /// acceptStaffInvite() has no invite_id parameter and no UI to pick
  /// among several candidates; it always resolves "the" invite to
  /// accept via a plain most-recent-PENDING lookup by phone alone. Two
  /// PENDING invites for the same phone from two *different* vendors
  /// would make that resolution genuinely ambiguous - and since
  /// VendorUser's own employee-uniqueness constraint below means at
  /// most one of them could ever actually be accepted anyway, the
  /// other would be left permanently dangling, the exact class of bug
  /// this whole line of fixes exists to prevent. A partial unique
  /// index, not a plain `@@unique`, only so a *historical* ACCEPTED row
  /// (a real audit record, per PDR-010's "retain the old record") never
  /// blocks the index itself - this index says nothing about whether
  /// inviting an already-employed phone again afterward is actually
  /// allowed; it is not, but that is `VendorsController.inviteStaff()`'s
  /// `ALREADY_VENDOR_MEMBER`/`EMPLOYEE_ALREADY_ASSIGNED` checks' job
  /// (phone-scoped advisory-lock-guarded, see that method's own
  /// comment), not this index's. Prisma's schema DSL cannot express a
  /// partial index, so this is declared here for documentation only -
  /// the actual index is created by hand in this model's migration
  /// (the same already-established pattern as VendorUser's role/branch
  /// CHECK constraint, which is likewise invisible to `schema.prisma`
  /// but real in the database).
  @@map("staff_invites")
}

/// Immutable, append-only audit trail - the source of truth for every
/// "must write an audit record" requirement across Part 2 (Part 3, G.3/G.4).
/// actorId is nullable: a System actor (background job, migration) writes
/// audit rows too, per Part 3's ownership note. correlationId is required
/// per Part 4, H.1: "every AuditLog row" carries it, propagated from the
/// request that triggered the write (or the job/worker's own correlation
/// id for a System-initiated one - never silently omitted).
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id])
  correlationId String
  action        String
  entityType    String
  entityId      String
  beforeState   Json?
  afterState    Json?
  occurredAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// The transactional outbox (ADR-006, Part 3 G.3): written in the same
/// Postgres transaction as the business write it accompanies - e.g.
/// checkout's CustomerOrder/VendorSuborder creation. A separate relay
/// worker (Part 6, M.4) polls Pending rows and publishes each to BullMQ,
/// marking it Published only on confirmed delivery. This is what makes
/// the checkout->notification/payment pipeline durable even if Redis is
/// briefly unavailable at the moment of commit.
model OutboxEvent {
  id           String            @id @default(uuid())
  eventType    String
  payload      Json
  status       OutboxEventStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  publishedAt  DateTime?
  attemptCount Int               @default(0)

  @@index([status, createdAt])
  @@map("outbox_events")
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Backs the Idempotency-Key convention (Part 4, H.1).
///
/// The row IS the atomicity mechanism: a request "claims" a key by
/// INSERTing a row (status IN_PROGRESS) and relying on the database's
/// unique-constraint enforcement - not an application-level
/// findUnique-then-write, which two concurrent requests can both pass
/// before either writes (the race the first version of this table had).
/// Whichever concurrent INSERT the database accepts first wins the
/// claim; the other gets a unique-violation error and must inspect the
/// winning row instead of proceeding.
///
/// `key` is the client-supplied header value, not globally unique on
/// its own - `scope` (the acting user/session; "anonymous" only until
/// EPIC-AUTH lands, see the interceptor) and `requestPath` are part of
/// the identity, so two different users - or two different endpoints -
/// can never collide on the same client-chosen string. `requestHash`
/// (method + path + body) is what a *reused* key with a *different*
/// payload is checked against - a mismatch is a 409, per Part 4, H.1
/// (a same-key-different-payload reuse is a conflict, not a replay).
model IdempotencyKey {
  id           String               @id @default(uuid())
  key          String
  scope        String
  requestPath  String
  requestHash  String
  status       IdempotencyKeyStatus @default(IN_PROGRESS)
  responseBody Json?
  responseCode Int?
  createdAt    DateTime             @default(now())
  completedAt  DateTime?
  expiresAt    DateTime

  @@unique([key, scope, requestPath], name: "idempotency_lookup")
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------
// Sprint 3 (EPIC-CAT / EPIC-MATCH / EPIC-VEND subset). Part 3, G.3's
// "Catalog & matching domain" table. Deliberately NOT built this sprint
// (see Part 8's sprint plan / 09-acceptance-traceability's OPEN items):
// AttributeDefinition/AttributeOption (BL-CAT-004, full attribute
// templates - BL-CAT-004b's specsText below is the FYP fallback),
// ProductMedia, OfferBranchInventory, PriceHistory, ProductMatch
// (BL-MATCH-003, queued/human-reviewed matches - this sprint only ships
// the exact-match auto-link path, BL-MATCH-002), ImportJob/ImportRow,
// FxRate. CanonicalProduct.product_type/warranty/tags are BL-CAT-003
// (Should/stretch) and are also deliberately omitted.
// ---------------------------------------------------------------------

/// Part 3, G.3 (FR-CAT-001): hierarchical category/subcategory tree,
/// AR/EN labels on every node. Self-referencing parentId; null means a
/// root category.
model Category {
  id        String     @id @default(uuid())
  nameAr    String
  nameEn    String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  canonicalProducts CanonicalProduct[]

  @@index([parentId])
  @@map("categories")
}

/// Part 3, G.3 (FR-CAT-002). Sprint 3 ships only the FK-satisfying
/// minimum a `CanonicalProduct` needs - a governed, non-duplicate name
/// list - not the full BL-CAT-002 feature (fuzzy duplicate-detection
/// UI/warnings), which Part 8's sprint plan marks Should/stretch and
/// defers past this sprint. `normalizedName` (lowercased/trimmed at
/// write time) gets a hard unique constraint, a mechanical collision
/// guard; it is not the fuzzy-similarity check FR-CAT-002 ultimately
/// wants.
model Brand {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())

  canonicalProducts CanonicalProduct[]

  @@map("brands")
}

/// Part 3, G.3: Draft -> PendingReview -> Published -> Archived
/// (listed as part of CanonicalProduct's own "Key fields" row, distinct
/// from the deferred product_type/warranty/tags of BL-CAT-003). Sprint 3
/// creates products directly at DRAFT/PUBLISHED (catalog-admin-authored,
/// no separate review workflow yet) - PENDING_REVIEW exists in the enum
/// because Part 3 specifies it, not because anything in this sprint
/// transitions a product into it.
enum CanonicalProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

/// Part 3, G.3 / FR-MATCH-008: level 1 of the four-level model - model
/// family identity (brand + category + model name). Never itself
/// buyable; a `CanonicalProduct` is never linked to directly by an
/// offer (see VendorOffer.canonicalProductId's comment) except as a
/// derived/display convenience of its variants' links.
///
/// (brandId, modelName) is deliberately NOT a hard unique constraint -
/// Part 3 explicitly calls for duplicate detection via ProductMatch
/// review (FR-CAT-009), not a DB constraint, since model names alone
/// aren't always unique across categories.
model CanonicalProduct {
  id         String                 @id @default(uuid())
  brandId    String
  brand      Brand                  @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category               @relation(fields: [categoryId], references: [id])
  modelName  String
  status     CanonicalProductStatus @default(DRAFT)
  /// Sprint 7 (RB-MATCH-003, approved-product-decisions-2026-09.md
  /// Sec 3.2): "The first confirmed matched offer supplies a
  /// provisional canonical name." Deliberately separate from
  /// `modelName` above - modelName is the platform-admin-authored model
  /// family identity set at CanonicalProduct creation (Sprint 3,
  /// BL-MATCH-001), while canonicalNameAr/En is customer-facing display
  /// text sourced from real seller usage, only ever set the moment the
  /// *first* vendor confirms a match (exact or non-exact review) to
  /// this product - null until then. Every later vendor who confirms a
  /// match to the same product must adopt it (their own VendorOffer.
  /// titleAr/titleEn is overwritten to match, in the same transaction
  /// as their confirmation) - see VendorOffersController.confirmMatch()
  /// and MatchReviewController.decide(). Changed only through
  /// CanonicalNameChangeRequest's admin-approval flow afterward, never
  /// silently by a later confirmation.
  canonicalNameAr String?
  canonicalNameEn String?
  createdAt  DateTime               @default(now())

  variants            CanonicalProductVariant[]
  vendorOffers        VendorOffer[]
  nameChangeRequests  CanonicalNameChangeRequest[]

  @@index([brandId])
  @@index([categoryId])
  @@map("canonical_products")
}

enum NameChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Sprint 7 (RB-MATCH-003, Sec 3.2): "Any matched vendor may request a
/// canonical-name change for admin approve/reject." A requester must
/// currently have at least one confirmed OfferVariant against this
/// CanonicalProduct (enforced in the controller, not the schema - see
/// CanonicalProductsController.requestNameChange()). Approval is the
/// only thing that ever changes CanonicalProduct.canonicalNameAr/En
/// after its initial first-confirmation set - and propagates to every
/// currently-matched VendorOffer's own title, the same "no different
/// names remain for the same matched product" invariant the initial
/// adoption enforces.
model CanonicalNameChangeRequest {
  id                 String                   @id @default(uuid())
  canonicalProductId String
  canonicalProduct   CanonicalProduct         @relation(fields: [canonicalProductId], references: [id])
  vendorId           String
  vendor             Vendor                   @relation(fields: [vendorId], references: [id])
  requestedNameAr    String
  requestedNameEn    String
  reason             String?
  status             NameChangeRequestStatus  @default(PENDING)
  decidedById        String?
  decidedBy          User?                    @relation(fields: [decidedById], references: [id])
  decidedAt          DateTime?
  createdAt          DateTime                 @default(now())

  @@index([canonicalProductId, status])
  @@map("canonical_name_change_requests")
}

/// Part 3, G.3 / FR-MATCH-008: level 2 - the manufacturer-distinct SKU-
/// defining variant (storage/color/size *when the manufacturer treats
/// it as a distinct model/MPN*), used for canonical-to-canonical
/// comparison. Never holds vendor-specific data (that's OfferVariant).
///
/// mpn is scoped-unique per Part 3 ((canonicalProductId, mpn) unique
/// where mpn present - Postgres's standard NULLs-don't-collide behavior
/// makes "where present" implicit). gtin gets an additional *global*
/// unique constraint beyond what Part 3's table literally lists: a GTIN
/// is a universal barcode standard (unique by definition, not just
/// within one product), and BL-MATCH-002's exact-match auto-link needs
/// a clean global index to query against.
model CanonicalProductVariant {
  id                     String           @id @default(uuid())
  canonicalProductId     String
  canonicalProduct       CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  /// JSON: storage/color/size etc., only for dimensions the manufacturer
  /// treats as a distinct model/MPN (FR-MATCH-008). Free-shape by design
  /// - Sprint 3 does not build AttributeDefinition/AttributeOption.
  structuralAttributes   Json
  mpn                    String?
  gtin                   String?          @unique
  /// Sprint 5 (RB-INV-001, PDR-018): the internal, platform-wide,
  /// permanently-stable identifier for this matched product variant -
  /// distinct from gtin/mpn (external, manufacturer-issued, optional)
  /// and from every vendor's own OfferVariant.storeInventoryBarcode
  /// (store-scoped, scanner-facing, editable by the vendor). Always
  /// auto-generated by the platform at creation time (CanonicalProductsController.
  /// createVariant), regardless of whether gtin/mpn exist - see
  /// common/barcode.util.ts for the same id-derived scheme
  /// storeInventoryBarcode's backfill uses. "Survives the first offer
  /// being archived/deleted/unmatched" because it lives here, on the
  /// shared canonical row, never on any one vendor's OfferVariant.
  /// Never returned by any public endpoint - CanonicalProductsController's
  /// variantToDto() deliberately omits it; do not add it there.
  platformProductBarcode String           @unique
  createdAt              DateTime         @default(now())

  confirmedOfferVariants OfferVariant[] @relation("ConfirmedMatch")
  proposedOfferVariants  OfferVariant[] @relation("ProposedMatch")
  matchReviewCandidates  MatchReviewCandidate[]

  @@unique([canonicalProductId, mpn])
  @@map("canonical_product_variants")
}

/// Part 3, G.3: a specific vendor's sellable listing. canonicalProductId
/// is nullable (null = unmatched/unique offer, FR-MATCH-001/009) and is
/// a **derived display convenience, never an independent source of
/// truth** (Part 3's tightened invariant): it must always equal the
/// canonicalProductId of every one of its OfferVariants' matched
/// canonical variant. The variant-level link (OfferVariant.
/// canonicalVariantId) is authoritative; this field is only ever
/// set/cleared by the same code path that sets/clears that one -
/// starting with BL-MATCH-002's auto-link, never independently.
enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model VendorOffer {
  id                 String            @id @default(uuid())
  vendorId           String
  vendor             Vendor            @relation(fields: [vendorId], references: [id])
  canonicalProductId String?
  canonicalProduct   CanonicalProduct? @relation(fields: [canonicalProductId], references: [id])
  titleAr            String
  titleEn            String
  status             OfferStatus       @default(DRAFT)
  createdAt          DateTime          @default(now())

  variants OfferVariant[]
  importIdentifierRecords ImportIdentifierRecord[]
  sectionMemberships StoreSectionOffer[]

  @@index([vendorId])
  @@index([canonicalProductId])
  /// Review-round fix (Sprint 7 round 3, Blocker 2): lets
  /// ImportIdentifierRecord.vendorOffer below be a composite FK on
  /// (vendorId, id) instead of id alone - id alone is already globally
  /// unique, so this adds no new uniqueness, only a target the composite
  /// FK can reference, which is what makes a cross-tenant link (vendor A's
  /// record pointing at vendor B's offer) rejected by Postgres itself
  /// rather than merely by application code.
  @@unique([vendorId, id])
  @@map("vendor_offers")
}

/// Sprint 7 round 2 fix (RB-MATCH-004 Blocker 3, PDR-019): the minimal
/// state needed to apply PDR-019's "same barcode + new colour/size is
/// additive, not a conflict" rule ACROSS separate import requests, not
/// just within one file. brandName/productType/mpn are otherwise
/// validation/grouping-only free text with nowhere else persisted (see
/// validate-import-row.ts's own comment) - without recording them here,
/// a second import batch referencing the same identifier would have no
/// evidence to check compatibility against, and no way to know which
/// existing VendorOffer a later matching row should attach to. A second
/// import can only ever safely merge into the first when neither side
/// contradicts the other on brand/product type/MPN (see
/// import/group-import-rows.ts's conflictingField()); anything else is
/// reported as a manual-review conflict, never guessed. Scoped to one
/// identifier per vendor - a barcode's real-world uniqueness is treated
/// as store-scoped here, the same as every other per-vendor uniqueness
/// rule in this schema (e.g. OfferVariant.storeInventoryBarcode).
///
/// Review-round fix (Sprint 7 round 3, Blocker 2): `vendorOffer` below is
/// a COMPOSITE foreign key on (vendorId, vendorOfferId) -> VendorOffer's
/// own (vendorId, id), not vendorOfferId alone - a single-column FK to
/// VendorOffer.id only proves the offer exists *somewhere*, not that it
/// belongs to THIS record's vendorId, so raw SQL (or a future bug) could
/// otherwise link vendor A's record to vendor B's offer. The composite FK
/// makes that rejected by Postgres itself.
model ImportIdentifierRecord {
  id              String              @id @default(uuid())
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  identifierType  OfferIdentifierType
  identifierValue String
  vendorOfferId   String
  vendorOffer     VendorOffer         @relation(fields: [vendorId, vendorOfferId], references: [vendorId, id])
  brandName       String?
  productType     String?
  mpn             String?
  updatedAt       DateTime            @updatedAt

  @@unique([vendorId, identifierType, identifierValue], map: "import_identifier_records_vendor_identifier_key")
  @@map("import_identifier_records")
}

enum OfferCondition {
  NEW
  USED
  REFURBISHED
  OPEN_BOX
}

/// FR-MATCH-002/BR-001's exact-identifier auto-link needs the vendor to
/// submit *some* raw identifier value to check - Part 3's "Key fields"
/// row for OfferVariant doesn't list one explicitly, but the table is a
/// summary, not exhaustive (it also omits every timestamp). identifierType
/// mirrors the identifier kinds BR-001 names; GTIN/EAN/UPC/ISBN are
/// treated as the same "global barcode" matching path (checked against
/// CanonicalProductVariant.gtin), MPN against .mpn.
enum OfferIdentifierType {
  GTIN
  EAN
  UPC
  ISBN
  MPN
}

/// Sprint 3 remediation (FR-MATCH-012, approved-product-decisions-2026-09.md
/// Sec 3.2 - not PDR-012, which is unrelated/covers store sections):
/// "the vendor must explicitly confirm a proposed match... Exact
/// identifier matches can be proposed automatically" - even BR-001's
/// exact-identifier match is now a *proposal*, never an immediate link,
/// so it can never affect comparison before the store owner acts on it
/// (FR-MATCH-009-style: an unconfirmed proposal must never be presented
/// as a canonical link). See MatchingService.findExactMatch() (renamed
/// conceptually to "propose", not "auto-link") and the
/// match-confirmation endpoint on VendorOffersController.
enum MatchProposalStatus {
  /// No exact-identifier match was found (or none was submitted) - a
  /// normal unmatched/unique offer, nothing to confirm.
  NONE
  /// An exact match was found at creation time and is awaiting the
  /// store owner's confirm/reject decision. canonicalVariantId is still
  /// null in this state - the offer has not entered comparison.
  PENDING
  /// The store owner confirmed the proposal - canonicalVariantId (and
  /// the parent VendorOffer's canonicalProductId) are now set.
  CONFIRMED
  /// The store owner rejected the proposal - the offer stays unmatched/
  /// unique (FR-MATCH-009); it is not re-proposed automatically.
  REJECTED
}

/// Part 3, G.3: level 3/4 - a vendor's specific sellable SKU. Never
/// redefines what the product structurally *is* (FR-MATCH-008); price,
/// condition, seller SKU and (until/unless matched) its own vendor-
/// authored specs live here.
///
/// specsText (BL-CAT-004b): the FYP fallback for the full attribute-
/// template system (BL-CAT-004, deferred) - one free-text field for
/// vendor-authored specs on an offer, AR/EN.
///
/// Sprint 3 remediation: `currency` removed entirely (PDR-001, ILS is
/// the only platform currency - see the removed-currency migration's
/// comment for what this column used to be). `canonicalVariantId` is
/// now set *only* on the store owner's explicit confirmation
/// (FR-MATCH-012/S3-B03) - `proposedCanonicalVariantId` +
/// `matchProposalStatus` hold an exact-identifier match found at
/// creation time until that confirmation happens.
model OfferVariant {
  id                         String                   @id @default(uuid())
  vendorId                   String
  vendor                     Vendor                   @relation(fields: [vendorId], references: [id])
  vendorOfferId              String
  vendorOffer                VendorOffer              @relation(fields: [vendorOfferId], references: [id])
  canonicalVariantId         String?
  canonicalVariant           CanonicalProductVariant? @relation("ConfirmedMatch", fields: [canonicalVariantId], references: [id])
  proposedCanonicalVariantId String?
  proposedCanonicalVariant   CanonicalProductVariant? @relation("ProposedMatch", fields: [proposedCanonicalVariantId], references: [id])
  matchProposalStatus        MatchProposalStatus      @default(NONE)
  sellerSku                  String
  condition                  OfferCondition           @default(NEW)
  basePrice                  Decimal                  @db.Decimal(10, 2)
  salePrice                  Decimal?                 @db.Decimal(10, 2)
  specsTextAr                String?
  specsTextEn                String?
  identifierType             OfferIdentifierType?
  identifierValue            String?
  /// Sprint 5 (RB-INV-001, PDR-018): "A seller must provide a barcode
  /// for every product... unique within a store. It is not
  /// automatically overwritten by the internal shared platform-product
  /// barcode." This is the scanner-facing, store-scoped identifier -
  /// deliberately a *different* field from identifierType/
  /// identifierValue above (the platform-matching identifier, checked
  /// against CanonicalProductVariant.gtin/mpn) and from
  /// CanonicalProductVariant.platformProductBarcode (internal, shared
  /// across vendors, never customer-facing - see that field's own
  /// comment). A vendor may submit their own manufacturer barcode here;
  /// if omitted, the platform auto-generates a printable one
  /// (VendorOffersController.createVariant / the backfill migration use
  /// the same deterministic id-derived scheme - see
  /// common/barcode.util.ts).
  storeInventoryBarcode      String
  createdAt                  DateTime                 @default(now())

  branchStocks           BranchStock[]
  stockMovements         StockMovement[]
  media                  OfferVariantMedia[]
  matchReviewCandidates  MatchReviewCandidate[]

  @@unique([vendorId, sellerSku])
  @@unique([vendorId, storeInventoryBarcode])
  /// Sprint 6 (RB-INV-002/003, RB-MATCH-001/002): backs the composite
  /// FKs from BranchStock/StockMovement/OfferVariantMedia/
  /// MatchReviewCandidate (vendorId, offerVariantId) -> (vendorId, id) -
  /// same reasoning as StoreBranch's own @@unique([vendorId, id])
  /// (Sprint 4): a plain id-only FK would only prove the variant row
  /// exists *somewhere*, not that it belongs to *this* vendorId.
  @@unique([vendorId, id])
  @@index([vendorOfferId])
  @@index([canonicalVariantId])
  @@index([proposedCanonicalVariantId])
  @@map("offer_variants")
}

/// Part 3, G.2 (FR-VEND-004, BR-SUBSCRIPTION). Sprint 3 remediation
/// (PDR-033): replaces the removed `SubscriptionPlan` tier selection
/// with a single unified sandbox/trial - one month, mock monthly
/// renewal, no real payment. `SubscriptionStatus` (on `Vendor`) tracks
/// whether the trial is currently ACTIVE or has lapsed into EXPIRED
/// (checked lazily, wherever the gate is evaluated - see
/// SubscriptionsController); this row records the trial period itself
/// and is mock-renewed via an explicit sandbox endpoint, the same
/// simulated-action pattern already used for OPEN-001 (payment) and
/// OPEN-004 (SMS) - there is no real billing, and no scheduled-job
/// worker in this codebase to renew it invisibly.
model VendorSubscription {
  id          String             @id @default(uuid())
  vendorId    String
  vendor      Vendor             @relation(fields: [vendorId], references: [id])
  status      SubscriptionStatus @default(ACTIVE)
  periodStart DateTime           @default(now())
  periodEnd   DateTime
  createdAt   DateTime           @default(now())

  @@index([vendorId])
  @@map("vendor_subscriptions")
}

// ---------------------------------------------------------------------
// Sprint 6 (RB-INV-002/003/005, RB-MATCH-001/002). Branch-level stock,
// its audit-complete movement log, basic offer-variant media, and the
// non-exact match review queue. Deliberately NOT built this sprint (see
// the post-sprint3 replan's own item list): cross-branch stock
// transfer, the barcode-scanner physical-sale flow (RB-INV-004), full
// media breadth (10 images/3 videos/reorder, RB-MATCH-001b),
// image-similarity ranking (RB-MATCH-002b), canonical-name adoption
// (RB-MATCH-003), and CSV/Excel import (RB-MATCH-004) - all explicitly
// deferred to a later sprint.
// ---------------------------------------------------------------------

/// Sprint 6 (RB-INV-002, PDR-020): "Physical stock is per branch/
/// variant. No transfer between branches is supported in phase 1."
/// This table is the only source of truth for a branch's on-hand
/// quantity - it is never written to directly by any endpoint; every
/// change goes through StockMovement (RB-INV-003/005) so the movement
/// log is genuinely complete, not just best-effort. A row is created
/// lazily by the first movement against a given (branchId,
/// offerVariantId) pair - there is no separate "initialize stock"
/// endpoint, since an explicit COUNT_CORRECTION movement from zero
/// already covers that case without a second write path.
model BranchStock {
  id             String       @id @default(uuid())
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  branchId       String
  /// Composite FK (vendorId, branchId) -> StoreBranch(vendorId, id) -
  /// same cross-vendor-integrity reasoning as VendorUser/StaffInvite's
  /// own composite FKs to StoreBranch (Sprint 4): a plain branchId ->
  /// StoreBranch.id FK would only prove the branch exists somewhere,
  /// not that it belongs to this same vendorId.
  branch         StoreBranch  @relation(fields: [vendorId, branchId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  offerVariantId String
  /// Composite FK (vendorId, offerVariantId) -> OfferVariant(vendorId,
  /// id) - same reasoning, against OfferVariant's own @@unique([vendorId, id]).
  offerVariant   OfferVariant @relation(fields: [vendorId, offerVariantId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  /// Never written directly - see this model's own comment. A DB-level
  /// CHECK (quantity >= 0), hand-written in this model's migration (not
  /// representable in Prisma's schema DSL, same already-established
  /// pattern as VendorUser's role/branchId CHECK), is the last line of
  /// defense against ever going negative - the real enforcement is the
  /// atomic conditional UPDATE in InventoryController's movement
  /// endpoint (RB-INV-005), which never even attempts a write that
  /// would violate it.
  quantity       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([branchId, offerVariantId])
  @@index([vendorId])
  @@map("branch_stock")
}

/// Sprint 6 (RB-INV-003, PDR-021): the three non-sale adjustment
/// reasons PDR-021 names. Physical-sale decrements (RB-INV-004, not
/// built this sprint - no scanner/checkout flow exists yet) would be a
/// separate reason if/when that flow lands; this enum deliberately only
/// covers the manual, non-sale case this sprint actually builds.
enum StockMovementReason {
  DAMAGE
  LOSS
  COUNT_CORRECTION
}

/// Sprint 6 (RB-INV-003, PDR-021): "Manual non-sale stock reductions
/// (damage, loss, count correction) need a mandatory reason and
/// immediately notify the owner, regardless of amount." Immutable,
/// append-only - the same convention AuditLog already established in
/// this codebase (Part 3, G.3/G.4): no controller in this codebase ever
/// updates or deletes a row here, full stop. `reasonNote` is required,
/// not optional - PDR-021's "mandatory reason" is satisfied by both the
/// required `reason` enum (the category) and this free-text field (the
/// actual explanation an owner reviewing the log would need - "why was
/// this damaged," not just "damage" again). `resultingQuantity` is the
/// BranchStock.quantity immediately after this movement was applied -
/// captured at write time so the log reads correctly even if later
/// movements change the current value.
model StockMovement {
  id                String              @id @default(uuid())
  vendorId          String
  vendor            Vendor              @relation(fields: [vendorId], references: [id])
  branchId          String
  branch            StoreBranch         @relation(fields: [vendorId, branchId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  offerVariantId    String
  offerVariant      OfferVariant        @relation(fields: [vendorId, offerVariantId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  quantityDelta     Int
  resultingQuantity Int
  reason            StockMovementReason
  reasonNote        String
  actorId           String
  actor             User                @relation(fields: [actorId], references: [id])
  createdAt         DateTime            @default(now())

  @@index([vendorId, branchId, offerVariantId])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Sprint 6 (RB-MATCH-001, PDR-011's later storefront use, current
/// scope basic-media-only): a primary image plus additional images per
/// offer variant. No video kind, no 10-image/3-video cap, no reorder
/// endpoint (RB-MATCH-001b, Should, not built this sprint) - `kind`
/// alone (PRIMARY vs ADDITIONAL) is enough to distinguish the hero
/// image; additional images are otherwise just ordered by createdAt.
/// No upload pipeline exists in this codebase - `url` is a plain,
/// already-hosted URL the vendor supplies (the same minimal pattern
/// StoreBranch.verificationPhotoUrl already uses).
enum MediaKind {
  PRIMARY
  ADDITIONAL
}

model OfferVariantMedia {
  id             String       @id @default(uuid())
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  offerVariantId String
  offerVariant   OfferVariant @relation(fields: [vendorId, offerVariantId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  url            String
  kind           MediaKind    @default(ADDITIONAL)
  createdAt      DateTime     @default(now())

  /// At most one PRIMARY image per variant. A partial unique index -
  /// not representable in Prisma's schema DSL, hand-written in this
  /// model's migration (same already-established pattern as
  /// StaffInvite's pending-invite index) - additional images are
  /// unrestricted in count this sprint (RB-MATCH-001b's 10-image cap is
  /// Should, deferred).
  @@index([offerVariantId])
  @@map("offer_variant_media")
}

/// Sprint 6 (RB-MATCH-002): the non-exact-match review queue -
/// candidates ranked by MatchingService.searchNonExactCandidates()
/// (structured-attribute + text-similarity scoring, no image-similarity
/// this sprint - RB-MATCH-002b) for an OfferVariant that has no exact-
/// identifier match (MatchProposalStatus.NONE on the offer variant
/// itself - this is a genuinely separate mechanism from that one, not a
/// replacement for it). PENDING candidates are what the review queue
/// shows; the store owner's approve/reject decision is the only thing
/// that ever changes `status`, the same "propose, never auto-link"
/// principle FR-MATCH-012 already established for exact matches.
/// "Request re-search" is simply calling the search endpoint again,
/// which re-scores and may surface new/updated candidates - no
/// separate re-search entity needed.
enum MatchReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model MatchReviewCandidate {
  id                 String                  @id @default(uuid())
  vendorId           String
  vendor             Vendor                  @relation(fields: [vendorId], references: [id])
  offerVariantId     String
  offerVariant       OfferVariant            @relation(fields: [vendorId, offerVariantId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  canonicalVariantId String
  canonicalVariant   CanonicalProductVariant @relation(fields: [canonicalVariantId], references: [id])
  /// Deterministic, documented scoring (see MatchingService) - 0.0-1.0,
  /// not a random/ML-derived value. Combines a text-similarity signal
  /// (offer title/specs vs. brand + model name) and a structured-
  /// attribute-overlap signal (does the offer's free text mention the
  /// canonical variant's structuralAttributes values) - see that
  /// method's own comment for the exact formula.
  score              Float
  status             MatchReviewStatus       @default(PENDING)
  createdAt          DateTime                @default(now())
  decidedAt          DateTime?

  /// Re-running search for the same offer variant against the same
  /// canonical variant refreshes this row (score/status) rather than
  /// creating a duplicate - see MatchingService.searchNonExactCandidates().
  @@unique([offerVariantId, canonicalVariantId])
  @@index([vendorId, status])
  @@map("match_review_candidates")
}

/// Sprint 8 (RB-STOREF-004/RB-COMP-001, PDR-013): "Public discovery has
/// external pages for All, Women, Men, Kids, and Accessories. Stores
/// choose one or more applicable types at registration and may edit
/// them." Only the All page is built this sprint (the four segment
/// pages are Should, deferred) - see VendorApplicableCategory's own
/// comment for why this field is required only at publish time, not at
/// registration.
enum StoreApplicableCategory {
  WOMEN
  MEN
  KIDS
  ACCESSORIES
}

/// Sprint 8 (RB-STOREF-004, PDR-013): "Stores choose one or more
/// applicable types AT REGISTRATION and may edit them." Round 1 of this
/// sprint deferred this to storefront-publish time only (the same
/// precedent PDR-007's contact-method requirement established) - the
/// product owner's review round 2 corrected this: PDR-013 is explicit
/// that registration itself is where this is required, not merely
/// "before going public." VendorsController.apply() now requires
/// CreateVendorDto.applicable_categories (non-empty) and creates these
/// rows in the SAME transaction as the vendor itself, so a newly-
/// accepted vendor can never exist with zero categories. A vendor from
/// BEFORE this fix (this migration is additive-only and never touches
/// historical rows) may still hold zero - StorefrontController.publish()
/// keeps its own >=1 check as the backstop for that pre-existing data,
/// and the owner-only GET/PUT endpoint there remains how any vendor,
/// old or new, edits this set later.
model VendorApplicableCategory {
  id        String                   @id @default(uuid())
  vendorId  String
  vendor    Vendor                   @relation(fields: [vendorId], references: [id])
  category  StoreApplicableCategory
  createdAt DateTime                 @default(now())

  @@unique([vendorId, category])
  @@map("vendor_applicable_categories")
}

/// Sprint 8 (RB-STOREF-002, PDR-012): "Store product sections are one
/// level: fixed All, automatic New arrivals and Discounts, plus vendor-
/// created sections... Maximum: 20 custom sections." Only CUSTOM
/// sections are stored rows here - All/New arrivals/Discounts are
/// computed on read (see StoreOffersPublicController), never owner-
/// editable, and never counted against the 20-section cap enforced in
/// StoreSectionsController.create() (advisory-locked per vendor, so two
/// concurrent creates can never both slip past the count check).
model StoreSection {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  name      String
  /// Owner-controlled display order among this vendor's own custom
  /// sections (the reorder endpoint reassigns these transactionally,
  /// fully overriding row-creation order).
  sortOrder Int
  createdAt DateTime @default(now())

  offers StoreSectionOffer[]

  @@index([vendorId, sortOrder])
  /// Backs StoreSectionOffer's own composite FK (vendorId, sectionId) ->
  /// (vendorId, id) - same tenant-safety reasoning as every other
  /// composite FK in this schema (e.g. OfferVariant's own
  /// @@unique([vendorId, id])).
  @@unique([vendorId, id])
  @@map("store_sections")
}

/// Many-to-many section membership: "a product can be in several
/// custom sections" (PDR-012). Both FKs are composite on vendorId - not
/// sectionId/offerId alone - so a join row can never straddle two
/// different vendors' data (e.g. vendor A's section referencing vendor
/// B's offer), the same defensive pattern this schema already applies
/// everywhere a join spans two vendor-owned tables. onDelete: Restrict
/// on both sides is deliberate: "delete a section removes only the
/// grouping" (PDR-012) is implemented by StoreSectionsController
/// explicitly deleting these join rows first, then the section, in one
/// transaction - never a DB-level cascade, so the removal is as
/// auditable/controlled as every other deletion-adjacent action in this
/// codebase.
model StoreSectionOffer {
  id        String       @id @default(uuid())
  vendorId  String
  sectionId String
  section   StoreSection @relation(fields: [vendorId, sectionId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  offerId   String
  offer     VendorOffer  @relation(fields: [vendorId, offerId], references: [vendorId, id], onDelete: Restrict, onUpdate: Cascade)
  createdAt DateTime     @default(now())

  @@unique([sectionId, offerId])
  @@index([vendorId, offerId])
  @@map("store_section_offers")
}
