generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts for Migrate/CLI
// purposes; the runtime PrismaClient gets its connection via a driver
// adapter (@prisma/adapter-pg) constructed from DATABASE_URL in code,
// not from a `url` field here - see https://pris.ly/d/prisma7-client-config
datasource db {
  provider = "postgresql"
}

/// Minimal placeholder for Part 3's User entity - expanded in Sprint 2
/// (EPIC-AUTH) with phone, password_hash, email, language_pref, etc.
/// Kept here only so AuditLog.actorId has something to reference now
/// (Part 3, G.3) without blocking Foundation on Auth's own schema work.
model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  auditLogs AuditLog[]

  @@map("users")
}

/// Immutable, append-only audit trail - the source of truth for every
/// "must write an audit record" requirement across Part 2 (Part 3, G.3/G.4).
/// actorId is nullable: a System actor (background job, migration) writes
/// audit rows too, per Part 3's ownership note. correlationId is required
/// per Part 4, H.1: "every AuditLog row" carries it, propagated from the
/// request that triggered the write (or the job/worker's own correlation
/// id for a System-initiated one - never silently omitted).
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id])
  correlationId String
  action        String
  entityType    String
  entityId      String
  beforeState   Json?
  afterState    Json?
  occurredAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// The transactional outbox (ADR-006, Part 3 G.3): written in the same
/// Postgres transaction as the business write it accompanies - e.g.
/// checkout's CustomerOrder/VendorSuborder creation. A separate relay
/// worker (Part 6, M.4) polls Pending rows and publishes each to BullMQ,
/// marking it Published only on confirmed delivery. This is what makes
/// the checkout->notification/payment pipeline durable even if Redis is
/// briefly unavailable at the moment of commit.
model OutboxEvent {
  id           String            @id @default(uuid())
  eventType    String
  payload      Json
  status       OutboxEventStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  publishedAt  DateTime?
  attemptCount Int               @default(0)

  @@index([status, createdAt])
  @@map("outbox_events")
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Backs the Idempotency-Key convention (Part 4, H.1).
///
/// The row IS the atomicity mechanism: a request "claims" a key by
/// INSERTing a row (status IN_PROGRESS) and relying on the database's
/// unique-constraint enforcement - not an application-level
/// findUnique-then-write, which two concurrent requests can both pass
/// before either writes (the race the first version of this table had).
/// Whichever concurrent INSERT the database accepts first wins the
/// claim; the other gets a unique-violation error and must inspect the
/// winning row instead of proceeding.
///
/// `key` is the client-supplied header value, not globally unique on
/// its own - `scope` (the acting user/session; "anonymous" only until
/// EPIC-AUTH lands, see the interceptor) and `requestPath` are part of
/// the identity, so two different users - or two different endpoints -
/// can never collide on the same client-chosen string. `requestHash`
/// (method + path + body) is what a *reused* key with a *different*
/// payload is checked against - a mismatch is a 409, per Part 4, H.1
/// (a same-key-different-payload reuse is a conflict, not a replay).
model IdempotencyKey {
  id           String               @id @default(uuid())
  key          String
  scope        String
  requestPath  String
  requestHash  String
  status       IdempotencyKeyStatus @default(IN_PROGRESS)
  responseBody Json?
  responseCode Int?
  createdAt    DateTime             @default(now())
  completedAt  DateTime?
  expiresAt    DateTime

  @@unique([key, scope, requestPath], name: "idempotency_lookup")
  @@index([expiresAt])
  @@map("idempotency_keys")
}
