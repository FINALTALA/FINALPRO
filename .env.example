# Copy to .env and fill in real values for local development.
# Nothing here is a production secret — see docs/srs/07-risks-and-decisions.md
# for which of these are still open product-owner decisions (OPEN-001, OPEN-004).

# --- Database (docker-compose.yml service: postgres) ---
DATABASE_URL="postgresql://finalpro:finalpro_dev_only@localhost:5432/finalpro?schema=public"

# --- Redis (docker-compose.yml service: redis) ---
# Backs login sessions and short-lived phone-verification tokens
# (Sprint 2, EPIC-AUTH) as well as rate-limiting counters (Part 6 M.2).
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3001

# --- Payment gateway (⚠ OPEN-001 — no provider selected yet) ---
# Left blank on purpose. The API must run in sandbox/simulated mode
# whenever this is unset, per Part 1 D.4 and Part 6 M.2.
PAYMENT_GATEWAY_PROVIDER=""
PAYMENT_GATEWAY_API_KEY=""

# --- SMS/OTP provider (⚠ OPEN-004 — no provider selected yet) ---
# Left blank on purpose. The API must fall back to a logged/visible
# admin-view OTP and notification path whenever this is unset.
SMS_PROVIDER=""
SMS_PROVIDER_API_KEY=""

# --- Error tracking ---
SENTRY_DSN=""

# --- Object storage (Cloudflare R2 recommended, Part 6 M.2) ---
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
